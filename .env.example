# Database (SQLite dev local — passer à Postgres en prod via DATABASE_URL)
DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="change-moi-en-prod-32-caracteres-minimum"
# IMPORTANT en prod : doit être l'URL PUBLIQUE réelle du site (https://...),
# jamais localhost. auth.js utilise cette valeur en priorité absolue (avant
# les en-têtes de la requête, même avec trustHost: true) pour construire les
# redirections de signIn/signOut — une valeur localhost oubliée ici renvoie
# les utilisateurs vers leur propre machine après une déconnexion en prod.
AUTH_URL="http://localhost:3000"

# PayPal (sandbox pour les tests)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"

# Clé publique PayPal pour le bouton de paiement (front)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Email de confirmation commande (SMTP — optionnel, ex. Brevo, Mailgun, Gmail)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
